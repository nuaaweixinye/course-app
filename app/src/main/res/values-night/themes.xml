<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark variant: Material 3. Surface/text resolved via night color resources. -->
    <style name="Theme.CourseShedule" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_indigo_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/text_primary_dark</item>

        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/outline_dark</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
